RewriteEngine On

Options -Indexes
DirectoryIndex public/index.php

RewriteRule ^(\.git|\.agents|app|bootstrap|database|storage|tests)(/|$) - [F,L]
RewriteRule (^|/)(\.htaccess|\.env|composer\.(json|lock)|bps\.sql|.*\.log|RESET\.txt)$ - [F,L]
RewriteRule \.(sql|log|bak|backup|old|orig|save|ini|env)$ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [L]

<IfModule php_module>
    php_value upload_max_filesize 20M
    php_value post_max_size 22M
    php_value memory_limit 256M
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
